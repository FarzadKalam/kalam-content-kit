{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kalam Video Project",
  "type": "object",
  "required": ["projectId", "brand", "canvas", "qualityMode", "generationModel", "directionMode", "presenterIds", "location", "lines"],
  "properties": {
    "projectId": {"type": "string", "pattern": "^[a-zA-Z0-9-]{16,64}$"},
    "brand": {"enum": ["kalametaze", "golbahar", "chenaran"]},
    "canvas": {"enum": ["landscape", "portrait"]},
    "qualityMode": {"enum": ["fast", "precise"]},
    "generationModel": {"enum": ["veo_3_1", "gemini_omni_flash"]},
    "directionMode": {"enum": ["news_bulletin", "explainer", "social_reel", "cinematic_report"]},
    "durationSeconds": {"enum": [4, 6, 8]},
    "resolution": {"enum": ["720p", "1080p"]},
    "speechEnabled": {"type": "boolean"},
    "presenterIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "location": {"type": "object", "required": ["mode", "id"], "properties": {"mode": {"enum": ["catalog", "new_from_reference", "exact_reference", "inspiration"]}, "id": {"type": "string"}, "assetIds": {"type": "array", "items": {"type": "string"}}}},
    "monitorText": {"type": "string", "maxLength": 160},
    "monitor": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "mode": {"enum": ["text", "images", "blank", "disabled"]},
        "text": {"type": "string", "maxLength": 240},
        "imageMode": {"enum": ["generate", "reference", "preserve"]},
        "imageCount": {"type": "integer", "minimum": 1, "maximum": 4},
        "brief": {"type": "string", "maxLength": 800},
        "assetIds": {"type": "array", "maxItems": 3, "items": {"type": "string"}}
      }
    },
    "lines": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["presenterId", "text", "shot"], "properties": {"presenterId": {"type": "string"}, "text": {"type": "string", "maxLength": 420}, "shot": {"enum": ["formal", "semi_formal", "close_up", "medium", "full", "moving", "podium", "microphone", "reference"]}}}},
    "timeline": {"type": "array", "items": {"type": "object", "required": ["startSecond", "endSecond", "description"], "properties": {"startSecond": {"type": "integer", "minimum": 0}, "endSecond": {"type": "integer", "minimum": 1}, "description": {"type": "string", "maxLength": 600}}}},
    "music": {"type": "object", "properties": {"mood": {"enum": ["calm", "serious", "uplifting", "neutral"]}, "continuityKey": {"type": "string"}}},
    "continuation": {"type": "object", "properties": {"parentProjectId": {"type": "string"}, "lastSegmentId": {"type": "string"}}}
  }
}
